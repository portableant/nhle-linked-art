[{"id": 714635, "comment": {"id": 494007, "parentId": null, "userId": "81b0549c-35b4-4531-9ba0-f53471e001ff", "username": "Steve Turner", "userAvatarUrl": "https://account.historicengland.org.uk/media/efvj20nd/steve.gif", "email": null, "itemId": 282394, "externalId": null, "memberId": "289368", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2018-06-02T10:33:02.897", "lastEdited": "2018-06-04T09:17:24.277", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Formerly the Grand Junction Canal, the Grand Union Canal was formed from an amalgamation of several formerly separate canals. Until the 1920s these had been independently owned and operated. The original part of the system was the Grand Junction Canal between Braunston and Brentford, constructed to reduce the route from the Midlands to London by sixty miles. This had locks fourteen feet wide, many branches to major towns and broad beam boats carrying up to seventy tons. Earlier linking canals were built with seven foot wide locks. The Regent's Canal acquired the Grand Junction and other canals in 1929 and created the new Grand Union Canal Company. In 1932, with government aid, extensive modernisation was carried out, including the widening of 52 locks between Braunston and Birmingham (Camp Hill), and the demolition and replacement of many 18th and early 19th century bridges; then the money ran out - and the World War II started, so the task was never completed. Photo May 1999.\n", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 494007, "filename": "bd7292d5-1620-4f2f-bcfc-a5ae6d71b516.jpg", "url": "https://historicengland.org.uk/etl/1319241/bd7292d5-1620-4f2f-bcfc-a5ae6d71b516.jpg", "starred": false, "description": null, "caption": null}, {"id": 776573, "comment": {"id": 536994, "parentId": null, "userId": "70b22c2a-abdc-4550-99a4-03d176cfee04", "username": "Nigel Cox", "userAvatarUrl": "https://account.historicengland.org.uk/media/k1afwp3y/2022-0388a-profile.jpg", "email": null, "itemId": 282394, "externalId": null, "memberId": "277701", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2019-04-10T21:30:36.06", "lastEdited": "2019-04-11T14:32:20.057", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographed 11/09/2013\n", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 536994, "filename": "4f0097df-3ed5-4e84-bc86-93cdb9fc234b.jpg", "url": "https://historicengland.org.uk/etl/1319241/4f0097df-3ed5-4e84-bc86-93cdb9fc234b.jpg", "starred": false, "description": null, "caption": null}, {"id": 802089, "comment": {"id": 555032, "parentId": null, "userId": "81b0549c-35b4-4531-9ba0-f53471e001ff", "username": "Steve Turner", "userAvatarUrl": "https://account.historicengland.org.uk/media/efvj20nd/steve.gif", "email": null, "itemId": 282394, "externalId": null, "memberId": "289368", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2019-09-09T08:49:39.48", "lastEdited": "2019-09-09T13:47:44.267", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photo June 1999.\n", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 555032, "filename": "e6c111bc-28e3-4d70-86c9-a4a5ad54c35b.jpg", "url": "https://historicengland.org.uk/etl/1319241/e6c111bc-28e3-4d70-86c9-a4a5ad54c35b.jpg", "starred": false, "description": null, "caption": null}]