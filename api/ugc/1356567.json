[{"id": 890889, "comment": {"id": 617721, "parentId": null, "userId": "70b22c2a-abdc-4550-99a4-03d176cfee04", "username": "Nigel Cox", "userAvatarUrl": "https://account.historicengland.org.uk/media/k1afwp3y/2022-0388a-profile.jpg", "email": null, "itemId": 312128, "externalId": null, "memberId": "277701", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2022-02-22T17:04:43.7687012", "lastEdited": "2022-02-22T17:04:43.7687012", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographed 20/09/2021.\n\nA very similar view, very similar viewpoint, repeat of the Images of England photograph of August 1999, taken more than 22 years previously. Apart from the addition of a couple of signs, little has changed in the interim.\n\nThe building is, and evidently was in 1999, named Admiral House. In 2021 it was primarily in use as a dental practice.", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 617721, "filename": "8395949b-95d5-445f-97a2-54eb5f3944b8.jpg", "url": "https://historicengland.org.uk/etl/1356567/8395949b-95d5-445f-97a2-54eb5f3944b8.jpg", "starred": false, "description": null, "caption": null}, {"id": 1258837, "comment": {"id": 820004, "parentId": null, "userId": "fc9a5e05-91c5-4ff4-a485-28843ccb47fb", "username": "Helen C-F", "userAvatarUrl": "https://account.historicengland.org.uk/image/get/genericavatar", "email": null, "itemId": 312128, "externalId": null, "memberId": "304000", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2026-04-30T20:33:09.5780214", "lastEdited": "2026-04-30T20:33:09.5780214", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographs taken 15th April 2026", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 820004, "filename": "b220fb10-13dc-4551-9024-98f0e62b8fc2.jpg", "url": "https://historicengland.org.uk/et