[{"id": 586727, "comment": {"id": 408567, "parentId": null, "userId": "c734b68d-05a9-4c45-ae6c-adff2350ff67", "username": "Roger Bowdler", "userAvatarUrl": "https://account.historicengland.org.uk/image/get/genericavatar", "email": null, "itemId": 207621, "externalId": null, "memberId": "267644", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2016-10-01T18:12:52.45", "lastEdited": "2016-10-03T11:38:34.8", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": false, "text": "2013 photographs. Ashridge is a stupendous house, of great ambition, and the strongest evidence for what Wyatt's Fonthill Abbey must have been. This is \"top-notch Wyatt Gothic\" re John martin Robinson, \"James Wyatt. Architect to George III\" (2011), 239; re Robinson (p.241), this was \"the largest, grandest and most complete new-built house in early-nineteenth-century England\". Wyatt drew on the medieval history of the site (a college of Augustinian Canons had stood here) in his commission - the largest of his career - for the Earl of Bridgwater, who had inherited the estate of a cousin, the Duke of Bridgwater.\n", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 408567, "filename": "b9724bc3-8954-47b8-996d-ba3bfd61fa5a.jpg", "url": "https://historicengland.org.uk/etl/1348442/b9724bc3-8954-47b8-996d-ba3bfd61fa5a.jpg", "starred": false, "description": null, "caption": null}, {"id": 586733, "comment": {"id": 408567, "parentId": null, "userId": "c734b68d-05a9-4c45-ae6c-adff2350ff67", "username": "Roger Bowdler", "userAvatarUrl": "https://account.historicengland.org.uk/image/get/genericavatar", "email": null, "itemId": 207621, "externalId": null, "memberId": "267644", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2016-10-01T18:12:52.45", "lastEdited": "2016-10-03T11:38:34.8", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": false, "text": "2013 photograp