[{"id": 924965, "comment": {"id": 638127, "parentId": null, "userId": "70b22c2a-abdc-4550-99a4-03d176cfee04", "username": "Nigel Cox", "userAvatarUrl": "https://account.historicengland.org.uk/media/k1afwp3y/2022-0388a-profile.jpg", "email": null, "itemId": 320984, "externalId": null, "memberId": "277701", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2022-09-27T21:11:08.7182145", "lastEdited": "2022-09-27T21:11:08.7182145", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographed 14/09/2022.\n\nUnfortunately the contributor made the mistake of duplicating the Images of England photograph of July 2000, and not looking at the Listing details thoroughly enough. The building is actually handed. This photograph shows the northern part of the front elevation, with 3 windows on each upper floor, and the slightly projecting forward central section with its 2 windows on each upper floor, with their ornate aprons, and the fine rainwater header. Unphotographed is the southern part which is identical for all practical purposes to the northern part, with 3 windows on each of its upper floors.   ", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 638127, "filename": "617d3917-4e2b-409d-92c7-7ace8b337335.jpg", "url": "https://historicengland.org.uk/etl/1078083/617d3917-4e2b-409d-92c7-7ace8b337335.jpg", "starred": false, "description": null, "caption": null}, {"id": 1001502, "comment": {"id": 684402, "parentId": null, "userId": "361a6806-dfb8-45c6-b4ca-ec4b7bdf639a", "username": "Yvonne Parker", "userAvatarUrl": "https://account.historicengland.org.uk/image/get/genericavatar", "email": null, "itemId": 320984, "externalId": null, "memberId": "332855", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2023-10-19T12:19:00.6786987", "lastEdited": "2023-10-19T12:19:00.6786987", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerifi