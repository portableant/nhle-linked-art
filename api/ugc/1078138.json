[{"id": 749492, "comment": {"id": 518622, "parentId": null, "userId": "70b22c2a-abdc-4550-99a4-03d176cfee04", "username": "Nigel Cox", "userAvatarUrl": "https://account.historicengland.org.uk/media/k1afwp3y/2022-0388a-profile.jpg", "email": null, "itemId": 223673, "externalId": null, "memberId": "277701", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2018-11-19T22:30:17.01", "lastEdited": "2018-11-20T09:20:15.95", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographed 21/10/2007\n", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 518622, "filename": "89cb04cf-5679-44d1-8ae2-dcb3f74c843b.jpg", "url": "https://historicengland.org.uk/etl/1078138/89cb04cf-5679-44d1-8ae2-dcb3f74c843b.jpg", "starred": false, "description": null, "caption": null}, {"id": 850382, "comment": {"id": 591447, "parentId": null, "userId": "81b0549c-35b4-4531-9ba0-f53471e001ff", "username": "Steve Turner", "userAvatarUrl": "https://account.historicengland.org.uk/media/efvj20nd/steve.gif", "email": null, "itemId": 223673, "externalId": null, "memberId": "289368", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2021-01-07T14:20:04.413", "lastEdited": "2021-01-07T16:23:29.293", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "It ceased to be the local civic headquarters in 1938. During the second world war it served as a canteen providing meals for people in need, particularly London evacuees. Home to a fishmonger's stall but becoming derelict Dacorum Borough Council proposed demolition in 1974. It was saved by local citizens and a new Trust was established in 1979. Restored by the Trust during the period 1982-1990 in 1983 it had been officially opened for commercial use as a shopping arcade called Lambs' Shops. Falling out of use, in 1998, it was leased to City Centre Restaurants and converted mostly to Cafe Uno subsequently acquired in 2006 by Paramount Restaurants and in 2007 re-branded as Brasserie Chez Gérard. It became Carluccios in 2012 and the Copper House in 2019. Photo April 2013.\n", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 591447, "filename": "617d32cb-7ed6-40c4-9992-b0daa7183cde.jpg", "url": "https://historicengland.org.uk/etl/1078138/617d32cb-7ed6-40c4-9992-b0daa7183cde.jpg", "starred": false, "description": null, "caption": null}, {"id": 890877, "comment": {"id": 617710, "parentId": null, "userId": "70b22c2a-abdc-4550-99a4-03d176cfee04", "username": "Nigel Cox", "userAvatarUrl": "https://account.historicengland.org.uk/media/k1afwp3y/2022-0388a-profile.jpg", "email": null, "itemId": 223673, "externalId": null, "memberId": "277701", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2022-02-22T16:14:31.3511326", "lastEdited": "2022-02-22T16:14:31.3511326", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographed 20/09/2021.", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 617710, "filename": "b1629276-39dc-42f0-a4fe-cc2a7a1aa924.jpg", "url": "https://historicengland.org.uk/etl/1078138/b1629276-39dc-42f0-a4fe-cc2a7a1aa924.jpg", "starred": false, "description": null, "caption": null}, {"id": 890878, "comment": {"id": 617711, "parentId": null, "userId": "70b22c2a-abdc-4550-99a4-03d176cfee04", "username": "Nigel Cox", "userAvatarUrl": "https://account.historicengland.org.uk/media/k1afwp3y/2022-0388a-profile.jpg", "email": null, "itemId": 223673, "externalId": null, "memberId": "277701", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2022-02-22T16:17:19.3548882", "lastEdited": "2022-02-22T16:17:19.3548882", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographed 20/09/2021.\n\nPart of the main front elevation.\n\nIn September 