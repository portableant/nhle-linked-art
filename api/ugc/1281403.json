[{"id": 891462, "comment": {"id": 618126, "parentId": null, "userId": "70b22c2a-abdc-4550-99a4-03d176cfee04", "username": "Nigel Cox", "userAvatarUrl": "https://account.historicengland.org.uk/media/k1afwp3y/2022-0388a-profile.jpg", "email": null, "itemId": 312300, "externalId": null, "memberId": "277701", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2022-02-27T11:00:32.2080763", "lastEdited": "2022-02-27T11:00:32.2080763", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographed 08/10/2021.\n\nThe current Listing Details state chimney to LH end. In fact, and assuming that the building is being described from the front, and although there is a chimney on the rear elevation at the LH end, the main chimney appears to be at the RH end.", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 618126, "filename": "6d124819-09d9-495c-9971-437a6cf0bd0b.jpg", "url": "https://historicengland.org.uk/etl/1281403/6d124819-09d9-495c-9971-437a6cf0bd0b.jpg", "starred": false, "description": null, "caption": null}]