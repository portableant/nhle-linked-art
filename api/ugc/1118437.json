[{"id": 891032, "comment": {"id": 617856, "parentId": null, "userId": "70b22c2a-abdc-4550-99a4-03d176cfee04", "username": "Nigel Cox", "userAvatarUrl": "https://account.historicengland.org.uk/media/k1afwp3y/2022-0388a-profile.jpg", "email": null, "itemId": 312166, "externalId": null, "memberId": "277701", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2022-02-24T12:33:58.4230786", "lastEdited": "2022-02-24T12:33:58.4230786", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographed 08/10/2021.\n\nThis is the main 5 bay front elevation on Aylesbury Street.\n\nThe \"Door with stone steps between 1st and 2nd bays from LH\", noted in the Listing details, had evidently already been removed by the time that the Images of England photograph was taken in September 2001.  \n\nHowever the 4 dormers in the roof have been added since September 2001.", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 617856, "filename": "21394b71-38ff-4b92-9c88-f029395a0c1c.jpg", "url": "https://historicengland.org.uk/etl/1118437/21394b71-38ff-4b92-9c88-f029395a0c1c.jpg", "starred": false, "description": null, "caption": null}, {"id": 891587, "comment": {"id": 618189, "parentId": null, "userId": "70b22c2a-abdc-4550-99a4-03d176cfee04", "username": "Nigel Cox", "userAvatarUrl": "https://account.historicengland.org.uk/media/k1afwp3y/2022-0388a-profile.jpg", "email": null, "itemId": 312166, "externalId": null, "memberId": "277701", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2022-02-27T21:09:41.4656999", "lastEdited": "2022-02-27T21:09:41.4656999", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographed 08/10/2021.\n\nA similar view repeat of the Images of England photograph of September 2001, taken more than 20 years previously.\n\nThis is the flank elevation onto Back Street. A window has been added at first floor level since 2001.\n\nVisible in this photo is the lump of puddingstone at ground level at the corner of the building.", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 618189, "filename": "007ec0ae-3c22-4b0e-b806-175e272956f5.jpg", "url": "https://historicengland.org.uk/etl/1118437/007ec0ae-3c22-4b0e-b806-175e272956f5.jpg", "starred": false, "description": null, "caption": null}]