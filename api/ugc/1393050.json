[{"id": 916537, "comment": {"id": 632873, "parentId": null, "userId": "d80511bd-6d68-48a4-a304-d9abf36eafa6", "username": "Nigel Westmancott", "userAvatarUrl": "https://account.historicengland.org.uk/image/get/genericavatar", "email": null, "itemId": 318570, "externalId": null, "memberId": "330448", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2022-08-08T11:40:10.1735187", "lastEdited": "2022-08-08T11:40:10.1735187", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Barrack blocks 8 - 19, Groves,  and 16- 21, Henderson are identical.  This is Henderson building 21.  Located close to the woods, facing the airman's mess it is the first in a column of three.", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 632873, "filename": "d0d16d08-1362-4dd3-bef7-c6227e9a9dca.JPG", "url": "https://historicengland.org.uk/etl/1393050/d0d16d08-1362-4dd3-bef7-c6227e9a9dca.JPG", "starred": false, "description": "A three story red brick barrack block.  A central window on the end  and six equally spaced windows on each floor.", "caption": null}]