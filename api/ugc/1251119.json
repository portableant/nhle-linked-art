[{"id": 924474, "comment": {"id": 637865, "parentId": null, "userId": "70b22c2a-abdc-4550-99a4-03d176cfee04", "username": "Nigel Cox", "userAvatarUrl": "https://account.historicengland.org.uk/media/k1afwp3y/2022-0388a-profile.jpg", "email": null, "itemId": 320859, "externalId": null, "memberId": "277701", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2022-09-25T21:58:48.2716793", "lastEdited": "2022-09-25T22:06:59.6145434", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographed 14/09/2022.\n\nIt should perhaps be noted that, at the time that this photograph was contributed, there was a disparity between the house numbers of this building as shown in the listing and as shown on the large scale Ordnance Survey map (Nos 6 & 8), and the number on the front door of the building (No 4).\n\nTo confuse matters still further the house was once No 1 High Street.\n\nIrrespective of the numbering this photograph and the earlier Images of England one do however definitely show the building that the Listing details describe.\n\nQueensway is shown as Queen Street on the large scale Ordnance Survey maps published in 1898, 1925, and 1949.", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 637865, "filename": "b521b05b-fb6c-42f5-9b45-29d92069362d.jpg", "url": "https://historicengland.org.uk/etl/1251119/b521b05b-fb6c-42f5-9b45-29d92069362d.jpg", "starred": false, "description": "", "caption": null}, {"id": 924475, "comment": {"id": 637866, "parentId": null, "userId": "70b22c2a-abdc-4550-99a4-03d176cfee04", "username": "Nigel Cox", "userAvatarUrl": "https://account.historicengland.org.uk/media/k1afwp3y/2022-0388a-profile.jpg", "email": null, "itemId": 320859, "externalId": null, "memberId": "277701", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2022-09-25T22:03:39.1475856", "lastEdited": "2022-09-25T22:07:44.9263144", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographed 14/09/2022.\n\nThe wrought iron railings, referred to in the Listing details.", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 637866, "filename": "7f093e60-e2c6-486c-9146-8687ba453090.jpg", "url": "https://historicengland.org.uk/etl/1251119/7f093e60-e2c6-486c-9146-8687ba453090.jpg", "starred": false, "description": "", "caption": null}, {"id": 1038670, "comment": {"id": 706226, "parentId": null, "userId": "fc9a5e05-91c5-4ff4-a485-28843ccb47fb", "username": "Helen C-F", "userAvatarUrl": "https://account.historicengland.org.uk/image/get/genericavatar", "email": null, "itemId": 320859, "externalId": null, "memberId": "304000", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2024-02-02T19:49:03.7526236", "lastEdited": "2024-02-02T19:49:03.7526236", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographs taken 24th January 2024", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 706226, "filename": "d2bad203-79a8-4c31-a90a-35e64dcb2aa8.jpg", "url": "https://historicengland.org.uk/etl/1251119/d2bad203-79a8-4c31-a90a-35e64dcb2aa8.jpg", "starred": false, "description": null, "caption": null}, {"id": 1038671, "comment": {"id": 706226, "parentId": null, "userId": "fc9a5e05-91c5-4ff4-a485-28843ccb47fb", "username": "Helen C-F", "userAvatarUrl": "https://account.historicengland.org.uk/image/get/genericavatar", "email": null, "itemId": 320859, "externalId": null, "memberId": "304000", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2024-02-02T19:49:03.7526236", "lastEdited": "2024-02-02T19:49:03.7526236", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographs taken 24th January 2024", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaType