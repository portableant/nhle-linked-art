[{"id": 881250, "comment": {"id": 611520, "parentId": null, "userId": "70b22c2a-abdc-4550-99a4-03d176cfee04", "username": "Nigel Cox", "userAvatarUrl": "https://account.historicengland.org.uk/media/k1afwp3y/2022-0388a-profile.jpg", "email": null, "itemId": 310050, "externalId": null, "memberId": "277701", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2021-11-30T21:09:26.893", "lastEdited": "2021-12-01T10:03:03.06", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographed 19/07/2009.\n\n\n\nYou will have to believe me that underneath all the vegetation in this photograph is the rectangular shape of the chapel....! The south-eastern corner is nearest the camera with the longer south side to the left and the shorter east side to the right. There is no evidence of each corner standing to about 5 metres, as understood to be described in the Listing Details.\n\n\n\nThere does not appear to be any knowledge of when the chapel fell into a ruinous state. However the 1884 edition of the Ordnance Survey's 6\" to the mile mapping shows the chapel and describes it as \"Remains of\".   \n", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 611520, "filename": "c634eca4-2a6e-449c-bdc1-b56a9cc7243f.jpg", "url": "https://historicengland.org.uk/etl/1348471/c634eca4-2a6e-449c-bdc1-b56a9cc7243f.jpg", "starred": false, "description": null, "caption": null}, {"id": 964095, "comment": {"id": 662986, "parentId": null, "userId": "fc9a5e05-91c5-4ff4-a485-28843ccb47fb", "username": "Helen C-F", "userAvatarUrl": "https://account.historicengland.org.uk/image/get/genericavatar", "email": null, "itemId": 310050, "externalId": null, "memberId": "304000", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2023-05-25T15:14:52.2015936", "lastEdited": "2023-05-25T15:14:52.2015936", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "t