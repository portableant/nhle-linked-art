[{"id": 890856, "comment": {"id": 617689, "parentId": null, "userId": "70b22c2a-abdc-4550-99a4-03d176cfee04", "username": "Nigel Cox", "userAvatarUrl": "https://account.historicengland.org.uk/media/k1afwp3y/2022-0388a-profile.jpg", "email": null, "itemId": 312119, "externalId": null, "memberId": "277701", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2022-02-22T12:49:41.576417", "lastEdited": "2022-02-22T12:49:41.576417", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographed 04/03/2021.\n\nThere are two very similar Wootton family monuments in the churchyard. It is unclear, to the outsider, whether the Listing refers to both or one. The Listing title refers to monuments in the plural, but the Listing details refer to a singular vault.\n\nThis photograph shows both monuments. The far one to the left is the north-western of the pair and stands on a stone plinth. The near one to the right is the south-eastern of the pair, and has a surround at its base of dressed stone blocks, some of which are broken.\n\nThe inscriptions are worn and not readily readable.    ", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 617689, "filename": "7f96d3ca-f1f8-47b7-8153-6af044d5989b.jpg", "url": "https://historicengland.org.uk/etl/1173676/7f96d3ca-f1f8-47b7-8153-6af044d5989b.jpg", "starred": false, "description": null, "caption": null}, {"id": 890857, "comment": {"id": 617690, "parentId": null, "userId": "70b22c2a-abdc-4550-99a4-03d176cfee04", "username": "Nigel Cox", "userAvatarUrl": "https://account.historicengland.org.uk/media/k1afwp3y/2022-0388a-profile.jpg", "email": null, "itemId": 312119, "externalId": null, "memberId": "277701", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2022-02-22T12:54:20.4974582", "lastEdited": "2022-02-22T12:54:20.4974582", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographed 04/03/2021.\n\nThis photograph shows the south and east sides of the north-western one of the pair, which stands on a stone plinth.\n\nThe plinth evidently supported metal railings at one time.\n\nThis is the vault shown in the Images of England photograph of the Listing. ", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 617690, "filename": "b8b436fb-064b-46b2-9370-c4f0e1c1b278.jpg", "url": "https://historicengland.org.uk/etl/1173676/b8b436fb-064b-46b2-9370-c4f0e1c1b278.jpg", "starred": false, "description": null, "caption": null}, {"id": 890859, "comment": {"id": 617692, "parentId": null, "userId": "70b22c2a-abdc-4550-99a4-03d176cfee04", "username": "Nigel Cox", "userAvatarUrl": "https://account.historicengland.org.uk/media/k1afwp3y/2022-0388a-profile.jpg", "email": null, "itemId": 312119, "externalId": null, "memberId": "277701", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2022-02-22T12:56:36.4463349", "lastEdited": "2022-02-22T12:56:36.4463349", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographed 04/03/2021.\n\nThis photograph shows the north side of the south-eastern one of the pair, with the base surround of broken dressed stone blocks.", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 617692, "filename": "4f87dedc-4944-48d7-a45b-9c7b0ba7a8d7.jpg", "url": "https://historicengland.org.uk/etl/1173676/4f87dedc-4944-48d7-a45b-9c7b0ba7a8d7.jpg", "starred": false, "description": null, "caption": null}, {"id": 917289, "comment": {"id": 633360, "parentId": null, "userId": "fc9a5e05-91c5-4ff4-a485-28843ccb47fb", "username": "Helen C-F", "userAvatarUrl": "https://account.historicengland.org.uk/image/get/genericavatar", "email": null, "itemId": 312119, "externalId": null, "memberId": "304000", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2022-08-13