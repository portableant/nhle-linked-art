[{"id": 714826, "comment": {"id": 494886, "parentId": null, "userId": "81b0549c-35b4-4531-9ba0-f53471e001ff", "username": "Steve Turner", "userAvatarUrl": "https://account.historicengland.org.uk/media/efvj20nd/steve.gif", "email": null, "itemId": 234764, "externalId": null, "memberId": "289368", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2018-06-04T15:51:30.343", "lastEdited": "2018-06-04T16:09:46.73", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "The Kings Arms is first recorded in the 18th century but was most famous for being frequented by Berkhamsted-born author Graham Greene. As a major staging post for travellers The King’s Arms became the principal inn of the town with a capacity to stable up to forty horses. It was also said to be the backdrop to a bit of debauchery from the King of France Louis XVIII, who reputedly used to sleep with the Landlord's daughter, Polly Page. James Snook, a highwayman, was an ostler here. He was hanged for his crimes on Boxmoor in 1802. The arms on the sign are not in fact those of any king but of Queen Anne. Photo April 2013.\n", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 494886, "filename": "40c0147d-2af3-40a8-8d9f-62122495909a.jpg", "url": "https://historicengland.org.uk/etl/1067748/40c0147d-2af3-40a8-8d9f-62122495909a.jpg", "starred": false, "description": null, "caption": null}, {"id": 890881, "comment": {"id": 617714, "parentId": null, "userId": "70b22c2a-abdc-4550-99a4-03d176cfee04", "username": "Nigel Cox", "userAvatarUrl": "https://account.historicengland.org.uk/media/k1afwp3y/2022-0388a-profile.jpg", "email": null, "itemId": 234764, "externalId": null, "memberId": "277701", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2022-02-22T16:36:02.1888039", "lastEdited": "2022-02-22T16:36:02.1888039", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographed 20/09/2021.\n\nShowing the passageway to the former stabling blocks at the rear.\n\nApart from the addition of the street level cigarette butt disposal bin, nothing appears to have changed since Steve Turner took his photograph in April 2013, more than eight years previously.  ", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 617714, "filename": "4847fe78-a29e-4b35-9834-8e4723c104db.jpg", "url": "https://historicengland.org.uk/etl/1067748/4847fe78-a29e-4b35-9834-8e4723c104db.jpg", "starred": false, "description": null, "caption": null}, {"id": 975028, "comment": {"id": 669115, "parentId": null, "userId": "fc9a5e05-91c5-4ff4-a485-28843ccb47fb", "username": "Helen C-F", "userAvatarUrl": "https://account.historicengland.org.uk/image/get/genericavatar", "email": null, "itemId": 234764, "externalId": null, "memberId": "304000", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2023-07-06T16:44:34.9507678", "lastEdited": "2023-07-06T16:44:34.9507678", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photograph taken 6th July 2023", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 669115, "filename": "ea373cc8-9e7e-4bbd-8df4-9eab43a7449d.jpg", "url": "https://historicengland.org.uk/etl/1067748/ea373cc8-9e7e-4bbd-8df4-9eab43a7449d.jpg", "starred": false, "description": null, "caption": null}]