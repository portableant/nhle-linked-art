[{"id": 909471, "comment": {"id": 628496, "parentId": null, "userId": "70b22c2a-abdc-4550-99a4-03d176cfee04", "username": "Nigel Cox", "userAvatarUrl": "https://account.historicengland.org.uk/media/k1afwp3y/2022-0388a-profile.jpg", "email": null, "itemId": 316702, "externalId": null, "memberId": "277701", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2022-06-29T13:49:30.7850139", "lastEdited": "2022-06-29T13:49:30.7850139", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographed 20/01/2022, from the public highway.\n\nThe remains now sit somewhat incongruously in the front garden of a modern house.\n\nIt took some time to reconcile the view in this photograph with the Images of England version taken in January 2005, but I think that the stone blocks supporting the arch in the 2022 photograph are the same as those to the right in the 2005 version, with the alcove beyond in the 2022 image being visible to the left in the 2005 one. This would indicate that the 2005 image was taken from where the footprint of the modern house is. \n\nThe large scale Ordnance Survey map of 1896 shows the extents of the remnant more or less as they existed at the time of this photograph, so it is evident that the Palace had been largely dismantled by then.", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 628496, "filename": "aae1f716-1a31-4206-9dce-75219688cedc.jpg", "url": "https://historicengland.org.uk/etl/1100417/aae1f716-1a31-4206-9dce-75219688cedc.jpg", "starred": false, "description": null, "caption": null}, {"id": 909472, "comment": {"id": 628497, "parentId": null, "userId": "70b22c2a-abdc-4550-99a4-03d176cfee04", "username": "Nigel Cox", "userAvatarUrl": "https://account.historicengland.org.uk/media/k1afwp3y/2022-0388a-profile.jpg", "email": null, "itemId": 316702, "externalId": null, "memberId": "277701", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2022-06-29T13:51:45.1820158", "lastEdited": "2022-06-29T13:51:45.1820158", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographed 20/01/2022, from the public highway.\n\nAnother view, showing the surviving NW corner of the former Palace. ", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 628497, "filename": "2e61bf54-2c33-47ac-babf-659dc48559f4.jpg", "url": "https://historicengland.org.uk/etl/1100417/2e61bf54-2c33-47ac-babf-659dc48559f4.jpg", "starred": false, "description": null, "caption": null}, {"id": 1248891, "comment": {"id": 815436, "parentId": null, "userId": "fc9a5e05-91c5-4ff4-a485-28843ccb47fb", "username": "Helen C-F", "userAvatarUrl": "https://account.historicengland.org.uk/image/get/genericavatar", "email": null, "itemId": 316702, "externalId": null, "memberId": "304000", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2026-03-26T20:44:08.1348969", "lastEdited": "2026-03-26T20:44:08.1348969", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographs taken 26th March 2026", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 815436, "filename": "3fb6d510-4800-4acd-9147-9990bf55eafc.jpg", "url": "https://historicengland.org.uk/etl/1100417/3fb6d510-4800-4acd-9147-9990bf55eafc.jpg", "starred": false, "description": null, "caption": null}, {"id": 1248892, "comment": {"id": 815436, "parentId": null, "userId": "fc9a5e05-91c5-4ff4-a485-28843ccb47fb", "username": "Helen C-F", "userAvatarUrl": "https://account.historicengland.org.uk/image/get/genericavatar", "email": null, "itemId": 316702, "externalId": null, "memberId": "304000", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2026-03-26T20:44:08.1348969", "lastEdited": "2026-03-26T20:44:08.1348969", "isCreatedByOrganisationUser": false, "edited": false, "is