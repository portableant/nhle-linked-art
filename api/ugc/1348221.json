[{"id": 725527, "comment": {"id": 501841, "parentId": null, "userId": "fb2ed734-ab1c-4c36-bafb-3eaeb5af8973", "username": "Trevor Baker", "userAvatarUrl": "https://account.historicengland.org.uk/image/get/genericavatar", "email": null, "itemId": 299032, "externalId": null, "memberId": "300484", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2018-07-28T16:20:44.5", "lastEdited": "2018-07-30T10:12:20.013", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": false, "text": "The disigner of this memorial was Sir George Frampton RA PRBS.  This is confirmed in St Lawrence Church magazine dated 1956 in the report on the death of Major Ronald Henderson on 10 February that year.  It is also apparent from the direct similarity of the lettering on the tomb with other works by George Frampton such as the Edward VII & Alexandra Coronation Medal.  The stylisitic trees on the tomb are also similar to stylistic trees on other memorials by George Frampton.\n", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 501841, "filename": "90a865c9-a68b-456b-9928-95a887199360.jpg", "url": "https://historicengland.org.uk/etl/1348221/90a865c9-a68b-456b-9928-95a887199360.jpg", "starred": false, "description": null, "caption": null}, {"id": 888642, "comment": {"id": 616093, "parentId": null, "userId": "70b22c2a-abdc-4550-99a4-03d176cfee04", "username": "Nigel Cox", "userAvatarUrl": "https://account.historicengland.org.uk/media/k1afwp3y/2022-0388a-profile.jpg", "email": null, "itemId": 299032, "externalId": null, "memberId": "277701", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2022-02-03T14:51:40.5032722", "lastEdited": "2022-02-03T14:51:40.5032722", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographed 11/03/2021.\n\nAn attempt to replicate the Images of England photograph from 2000, with a similar view, similar viewpoint.", "