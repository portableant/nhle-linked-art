[{"id": 776234, "comment": {"id": 536672, "parentId": null, "userId": "70b22c2a-abdc-4550-99a4-03d176cfee04", "username": "Nigel Cox", "userAvatarUrl": "https://account.historicengland.org.uk/media/k1afwp3y/2022-0388a-profile.jpg", "email": null, "itemId": 251008, "externalId": null, "memberId": "277701", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2019-04-12T18:40:58.26", "lastEdited": "2019-04-15T09:07:30.247", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographed 03/09/2014.\n\n\n\nThis is Puttenham Bottom Lock No 11.\n\n\n\nThe white deposits on the side walls of the lock are the remnants of the foam that filled the entire surface of the water in the lock before it was emptied to get the boat through.\n\n\n", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 536672, "filename": "d8f432d9-af2f-4130-9a05-355ce6ca91e6.jpg", "url": "https://historicengland.org.uk/etl/1332840/d8f432d9-af2f-4130-9a05-355ce6ca91e6.jpg", "starred": false, "description": null, "caption": null}]