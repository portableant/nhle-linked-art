[{"id": 776490, "comment": {"id": 536628, "parentId": null, "userId": "70b22c2a-abdc-4550-99a4-03d176cfee04", "username": "Nigel Cox", "userAvatarUrl": "https://account.historicengland.org.uk/media/k1afwp3y/2022-0388a-profile.jpg", "email": null, "itemId": 264100, "externalId": null, "memberId": "277701", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2019-04-12T17:44:14.297", "lastEdited": "2019-04-15T09:04:15.563", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographed 02/09/2014.\n\n\n\nThis is the west side of the bridge with the lock visible through the arch.\n\n\n\nAt the time of the photograph the parapet at the top right had recently taken a severe battering, and was under repair. Evidently a more serious repair to the parapet had been necessary in the past.\n", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 536628, "filename": "c92fd76f-df4e-49d3-860f-1dbbbc76b0c6.jpg", "url": "https://historicengland.org.uk/etl/1342232/c92fd76f-df4e-49d3-860f-1dbbbc76b0c6.jpg", "starred": false, "description": null, "caption": null}]