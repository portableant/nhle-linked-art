[{"id": 891044, "comment": {"id": 617865, "parentId": null, "userId": "70b22c2a-abdc-4550-99a4-03d176cfee04", "username": "Nigel Cox", "userAvatarUrl": "https://account.historicengland.org.uk/media/k1afwp3y/2022-0388a-profile.jpg", "email": null, "itemId": 312168, "externalId": null, "memberId": "277701", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2022-02-24T13:46:45.3326289", "lastEdited": "2022-02-24T13:46:45.3326289", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographed 08/10/2021.\n\nIn October 2021 the main part of the building was in use as the Lucca restaurant and bar. The use by National Westminster Bank was not even evident in the Images of England photograph of January 2001, let alone in October 2021.\n\nThe near part of the building is the right hand end in the Listing details, featuring the 2 small swept dormers. ", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 617865, "filename": "461440b4-ab17-4797-bbcc-83d53ceccc01.jpg", "url": "https://historicengland.org.uk/etl/1118407/461440b4-ab17-4797-bbcc-83d53ceccc01.jpg", "starred": false, "description": null, "caption": null}, {"id": 891588, "comment": {"id": 618190, "parentId": null, "userId": "70b22c2a-abdc-4550-99a4-03d176cfee04", "username": "Nigel Cox", "userAvatarUrl": "https://account.historicengland.org.uk/media/k1afwp3y/2022-0388a-profile.jpg", "email": null, "itemId": 312168, "externalId": null, "memberId": "277701", "numberOfContributions": 0, "isLoggedInUsersComment": false, "created": "2022-02-27T21:11:54.8089929", "lastEdited": "2022-02-27T21:11:54.8089929", "isCreatedByOrganisationUser": false, "edited": false, "isUserVerified": true, "text": "Photographed 08/10/2021.\n\nA front on view of the right hand side of the building.", "pinnedPriority": 0, "currentStatusId": 2}, "blobStorageUrl": null, "mediaTypeId": 1, "commentId": 618190, "filename": "f10a9682-20e2-47b4-a